        .sort(function (a, b) { return b.avgMs - a.avgMs; });
}
function _perfRenderOverlay() {
    try {
        if (!_perfEnabled()) { var ex = document.getElementById('sl-perf'); if (ex) ex.remove(); return; }
        var el = document.getElementById('sl-perf');
