            const sevMap = { 'Catastrophic': 1e-9, 'Hazardous': 1e-7, 'Major': 1e-5, 'Minor': 1e-3, 'No Safety Effect': 1.0 };
            return sevMap[fha.severity] != null ? sevMap[fha.severity] : null;
