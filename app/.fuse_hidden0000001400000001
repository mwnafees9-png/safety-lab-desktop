function _ftaExpandPathToNode(root, target) {
    let path = null;
    (function rec(n, trail) {
        if (!n || path) return;
        const here = trail.concat([n]);
        if (n === target) { path = here; return; }
        const kids = n.children || n._children;
        if (kids) kids.forEach(c => rec(c, here));
