// Phase 56.40 — Same physical event. Restore source logicalId on every pasted
// node so the existing repeated-event machinery treats source and pasted
// instances as one shared event. Propagate field updates so they stay in sync.
function applyPasteMode_SameEvent(branchRoot) {
    (function walk(n) {
        if (!n) return;
        if (n._originalLogicalId != null) {
            n.logicalId = n._originalLogicalId;
        }
        delete n._originalLogicalId;
        const kids = n.children || n._children;
        if (kids) kids.forEach(walk);
    })(branchRoot);
    if (typeof propagateRepeatedEventEdit === 'function') {
        (function sync(n) {
            if (!n) return;
            propagateRepeatedEventEdit(n);
            const kids = n.children || n._children;
            if (kids) kids.forEach(sync);
        })(branchRoot);
    }
}
