        return;
    }
    const existingKeys = new Set((cmaData || []).map(c => c.autoKey).filter(Boolean));
    const ccfGroups = new Map();    // groupName -> { beta, gamma, delta, members: [{page, node}] }
    const sharedByLid = new Map();  // logicalId -> [{page, node}]
