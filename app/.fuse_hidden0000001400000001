            if (t.stripeId) {
                btn = '<button class="pw-tier-btn" onclick="window.SafetyLab._paywallSubscribe(\'' + key + '\')">' + t.cta + '</button>';
            } else if (key === 'edu') {
                // Phase 56.33 — free EDU; the path is "sign out, sign back in with
