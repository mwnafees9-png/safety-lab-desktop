function refreshLibraryDependentNodes() {
    ftaPages.forEach(page => {
        (function walk(n) {
            if (!n) return;
            if (n.inputMode === 'library' && n.libraryKey) {
                n.lambda = lambdaFromInputMode('library', 0, n.libraryKey, ftaConfig.exposureTime);
            }
