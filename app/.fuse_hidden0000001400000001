        rows.forEach(({ row, id }) => {
            const opt = document.createElement('option');
            opt.value = id;
            opt.text = _fhaLabel(row);
            sel.appendChild(opt);
        });
        if (current && Array.from(sel.options).some(o => o.value === current)) {
            sel.value = current;
        }
