            };
            const t = tones[ev.state] || tones['no-mirror'];
            parts.push('<span class="ar-badge ar-badge-verify" title="' + esc(ev.detail || '') + '" style="background: ' + t.bg + '; color: ' + t.fg + '; border: 1px solid ' + t.border + ';">' + esc(ev.label) + '</span>');
        }
