{
  "name": "safety-lab-aero-desktop",
  "productName": "Safety Lab Aero",
  "version": "0.18.1",
  "description": "Safety Lab Aero — desktop build. Electron shell around the SAME web bundle (pulled from a wall-passed, stripped build), signed-license gate, real sign-in, network egress allowlist, safetylab:// links.",
  "author": "Muhammad Waqas Nafees",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "vendor": "bash vendor-libs.sh",
    "pull": "bash pull-web.sh",
    "start": "electron .",
    "dev": "SKIP_WALL=1 bash pull-web.sh && electron .",
    "test": "for t in tests/*.test.js; do node \"$t\" || exit 1; done",
    "dist:mac": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac",
    "dist:mac:signed": "electron-builder --mac",
    "dist:win": "electron-builder --win --x64",
    "release": "bash release.sh --publish",
    "release:build": "bash release.sh",
    "release:win": "bash release.sh --win --publish"
  },
  "build": {
    "appId": "com.safetylabaero.desktop",
    "productName": "Safety Lab Aero",
    "files": [
      "main.js",
      "shell_rules.js",
      "update_verify.js",
      "preload-app.js",
      "preload-gate.js",
      "preload-settings.js",
      "settings.html",
      "onboarding.html",
      "lock.html",
      "agreements/**/*",
      "build/icon.png",
      "app/**/*",
      "!app/**/.DS_Store"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "afterPack": "afterPack.js",
    "afterSign": "notarize.js",
    "dmg": {
      "artifactName": "SafetyLabAero-${os}-${arch}.${ext}",
      "title": "Safety Lab Aero ${version}",
      "background": "build/dmg-background.png",
      "window": {
        "width": 600,
        "height": 400
      },
      "iconSize": 120,
      "contents": [
        {
          "x": 150,
          "y": 205,
          "type": "file"
        },
        {
          "x": 450,
          "y": 205,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "artifactName": "SafetyLabAero-win-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Safety Lab Aero"
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://updates.safetylabaero.com/desktop/"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  }
}
